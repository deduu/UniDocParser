# ------------------------------------------------------------------------------
# UniDoc Agent - Environment Variables
# ------------------------------------------------------------------------------
# This file provides an example of the environment variables needed to run the
# application. Copy this file to .env and fill in the values.
# The application will load these variables at startup.
# ------------------------------------------------------------------------------

# OpenAI Credentials (required if using OpenAI models)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"

# CUDA Device Configuration
# Sets the default CUDA devices for the models.
FIG2TAB_MODEL_DEVICE="cuda:0"
FORMATTER_MODEL_DEVICE="cuda:1"
